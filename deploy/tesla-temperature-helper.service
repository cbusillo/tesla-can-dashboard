[Unit]
Description=Private Tesla Bluetooth temperature helper
After=bluetooth.service

[Service]
Type=simple
User=root
Group=nogroup
RuntimeDirectory=tesla-temperature
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/tesla-can-dashboard
ExecStart=/opt/tesla-can-dashboard/.venv/bin/python -m tesla_can_dashboard.ble_helper --socket /run/tesla-temperature/helper.sock --key-directory /var/lib/tesla-controls --allowed-uid 65534 --socket-gid 65534
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
