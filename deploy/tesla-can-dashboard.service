[Unit]
Description=Receive-only Tesla CAN dashboard
After=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/opt/tesla-can-dashboard
ExecStart=/opt/tesla-can-dashboard/.venv/bin/tesla-can-dashboard --interface can0 --bind 0.0.0.0 --data-dir /var/lib/tesla-can-dashboard --assets /opt/tesla-can-dashboard/web/dist
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN
ReadWritePaths=/var/lib/tesla-can-dashboard
UMask=0077

[Install]
WantedBy=multi-user.target
